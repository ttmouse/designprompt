{
  "version": "1.0.0",
  "name": "AI Core Quality Gates",
  "description": "Minimal but critical hard constraints to ensure high-frequency, high-quality output.",
  "gates": [
    {
      "id": "contrast_min",
      "desc": "Text/Background contrast >= 4.5",
      "target": {
        "min_contrast_ratio": 4.5
      }
    },
    {
      "id": "primary_focal_only",
      "desc": "Only one primary focal point per view",
      "target": {
        "max_primary_actions": 1
      }
    },
    {
      "id": "font_base_min",
      "desc": "Base body font size >= 16px",
      "target": {
        "min_px": 16
      }
    },
    {
      "id": "line_height_range",
      "desc": "Line height 1.5–1.8",
      "target": {
        "min": 1.5,
        "max": 1.8
      }
    },
    {
      "id": "line_length_range",
      "desc": "40–75 characters per line",
      "target": {
        "min_chars": 40,
        "max_chars": 75
      }
    },
    {
      "id": "grid_unit",
      "desc": "Strict 8px baseline grid",
      "target": {
        "grid_unit_px": 8
      }
    },
    {
      "id": "no_ambiguous_spacing",
      "desc": "Prohibit ambiguous spacing values",
      "target": {
        "allowed_units": [
          4,
          8,
          12,
          16,
          24,
          32
        ]
      }
    },
    {
      "id": "no_grey_on_color_bg",
      "desc": "Prohibit grey text on colored backgrounds",
      "target": {
        "allowed": false
      }
    }
  ],
  "prompt": "Quality gates: contrast >=4.5; single primary focal; base size >=16px; line-height 1.5–1.8; line length 40–75; strict 8px grid; only spacing [4,8,12,16,24,32]; forbid grey text on colored BG."
}