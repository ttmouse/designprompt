{
  "version": "1.0.0",
  "source": "Refactoring UI - Book",
  "url": "https://online.fliphtml5.com/uejlb/wnsd/",
  "score_weights": {
    "hierarchy": 0.2,
    "layout_spacing": 0.15,
    "typography": 0.2,
    "color": 0.15,
    "depth": 0.1,
    "images": 0.1,
    "finishing": 0.1
  },
  "categories": [
    {
      "id": "hierarchy",
      "name": "Visual Hierarchy",
      "rules": [
        {
          "id": "focal_point_single",
          "type": "constraint",
          "description": "Only one primary focal point per view",
          "target": {
            "max_primary_actions": 1
          },
          "severity": "high"
        },
        {
          "id": "contrast_min",
          "type": "constraint",
          "description": "Text/Background contrast threshold",
          "target": {
            "min_contrast_ratio": 4.5
          },
          "severity": "high"
        },
        {
          "id": "de_emphasize_secondary",
          "type": "constraint",
          "description": "De-emphasize secondary information",
          "target": {
            "secondary_emphasis": "reduced"
          },
          "severity": "medium"
        },
        {
          "id": "separate_visual_doc_hierarchy",
          "type": "principle",
          "description": "Visual hierarchy is not equal to document structure"
        }
      ]
    },
    {
      "id": "layout_spacing",
      "name": "Layout & Spacing",
      "rules": [
        {
          "id": "base_grid",
          "type": "constraint",
          "description": "Uniform 8px baseline grid",
          "target": {
            "grid_unit_px": 8
          },
          "severity": "high"
        },
        {
          "id": "spacing_scale",
          "type": "constraint",
          "description": "Standard spacing scale",
          "target": {
            "scale": [
              4,
              8,
              12,
              16,
              24,
              32
            ]
          },
          "severity": "medium"
        },
        {
          "id": "ambiguous_spacing_forbidden",
          "type": "constraint",
          "description": "Prohibit ambiguous spacing values",
          "target": {
            "allowed_units": [
              4,
              8,
              12,
              16,
              24,
              32
            ]
          },
          "severity": "high"
        },
        {
          "id": "container_max_width",
          "type": "constraint",
          "description": "Maximum container width",
          "target": {
            "max_width_px": 1200
          },
          "severity": "low"
        }
      ]
    },
    {
      "id": "typography",
      "name": "Typography & Readability",
      "rules": [
        {
          "id": "base_font_size",
          "type": "constraint",
          "description": "Base body font size",
          "target": {
            "min_px": 16
          },
          "severity": "high"
        },
        {
          "id": "line_height_range",
          "type": "constraint",
          "description": "Line height range",
          "target": {
            "min": 1.5,
            "max": 1.8
          },
          "severity": "medium"
        },
        {
          "id": "max_line_length",
          "type": "constraint",
          "description": "Maximum characters per line",
          "target": {
            "min_chars": 40,
            "max_chars": 75
          },
          "severity": "high"
        },
        {
          "id": "link_color_optional",
          "type": "principle",
          "description": "Links do not strictly require color distinction"
        }
      ]
    },
    {
      "id": "color",
      "name": "Color Usage",
      "rules": [
        {
          "id": "use_hsl",
          "type": "principle",
          "description": "Use HSL for color definitions"
        },
        {
          "id": "shades_defined",
          "type": "constraint",
          "description": "Define 7+ shades for each primary color",
          "target": {
            "min_shades": 7
          },
          "severity": "medium"
        },
        {
          "id": "accessibility_contrast",
          "type": "constraint",
          "description": "Accessibility contrast requirement",
          "target": {
            "min_contrast_ratio": 4.5
          },
          "severity": "high"
        },
        {
          "id": "no_grey_on_color_bg",
          "type": "constraint",
          "description": "Prohibit grey text on colored backgrounds",
          "target": {
            "allowed": false
          },
          "severity": "high"
        }
      ]
    },
    {
      "id": "depth",
      "name": "Creating Depth",
      "rules": [
        {
          "id": "light_source_consistent",
          "type": "principle",
          "description": "Consistent light source direction"
        },
        {
          "id": "shadow_layers",
          "type": "constraint",
          "description": "Shadow layering",
          "target": {
            "layers": [
              "umbra",
              "penumbra"
            ]
          },
          "severity": "low"
        },
        {
          "id": "elevation_levels",
          "type": "constraint",
          "description": "Define elevation levels",
          "target": {
            "levels": [
              "sm",
              "md",
              "lg"
            ]
          },
          "severity": "medium"
        }
      ]
    },
    {
      "id": "images",
      "name": "Image Treatment",
      "rules": [
        {
          "id": "text_overlay_contrast",
          "type": "constraint",
          "description": "Maintain consistent contrast for text overlays",
          "target": {
            "min_contrast_ratio": 4.5
          },
          "severity": "high"
        },
        {
          "id": "intended_size",
          "type": "principle",
          "description": "Each image has a preset size"
        },
        {
          "id": "user_upload_caution",
          "type": "principle",
          "description": "Handle user-uploaded content with caution"
        }
      ]
    },
    {
      "id": "finishing",
      "name": "Finishing Touches",
      "rules": [
        {
          "id": "supercharge_defaults",
          "type": "principle",
          "description": "Supercharge default styles"
        },
        {
          "id": "accent_borders",
          "type": "principle",
          "description": "Introduce color via accent borders"
        },
        {
          "id": "reduce_borders",
          "type": "principle",
          "description": "Reduce border usage"
        },
        {
          "id": "empty_states",
          "type": "principle",
          "description": "Provide empty states"
        }
      ]
    }
  ],
  "prompt_suite": {
    "hierarchy": "Use clear visual hierarchy: single focal primary action; maintain contrast >=4.5; de-emphasize secondary info; separate visual and document hierarchy.",
    "typography": "Typography: base size >=16px; line-height 1.5–1.8; max line 40–75 chars; link color optional.",
    "layout_spacing": "Spacing: strict 8px grid; use scale [4,8,12,16,24,32]; avoid ambiguous spacing; container max 1200px.",
    "color": "Color in HSL; per-color >=7 shades; text/background contrast >=4.5; forbid grey text on colored backgrounds.",
    "depth": "Depth: consistent light source; two-part shadows; elevation levels sm|md|lg.",
    "images": "Images: maintain text overlay contrast >=4.5; respect intended sizes; caution for user uploads.",
    "finishing": "Finishing: supercharge defaults; use accent borders; reduce borders; include empty states."
  }
}