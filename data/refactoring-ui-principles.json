{
  "source": "Refactoring UI - Book",
  "url": "https://online.fliphtml5.com/uejlb/wnsd/",
  "principles": [
    {
      "category": "从零开始",
      "items": [
        "从具体功能开始，而不是从布局开始",
        "细节稍后再处理",
        "不要过度设计",
        "为界面选择明确的个性",
        "限制你的选择集"
      ]
    },
    {
      "category": "层级即一切",
      "items": [
        "并非所有元素同等重要",
        "大小并非一切",
        "避免在彩色背景上使用灰色文字",
        "通过弱化来突出重点",
        "标签是最后的手段",
        "视觉层级与文档层级分离",
        "平衡字重与对比度",
        "语义是次要的"
      ]
    },
    {
      "category": "布局与间距",
      "items": [
        "以更充足的留白开局",
        "建立统一的间距与尺寸体系",
        "不必填满整屏",
        "栅格并非万能",
        "相对尺寸不好扩展",
        "避免模糊的间距"
      ]
    },
    {
      "category": "文本设计",
      "items": [
        "建立字号等级体系",
        "使用高质量字体",
        "控制合理的行宽",
        "以基线对齐，而非居中对齐",
        "行高应与字号成比例",
        "并非所有链接都必须用颜色区分",
        "以可读性为导向进行对齐",
        "合理使用字距"
      ]
    },
    {
      "category": "颜色运用",
      "items": [
        "用 HSL 替代十六进制颜色",
        "你需要的颜色比想象中更多",
        "预先定义色阶",
        "避免亮度削弱饱和度",
        "灰色不必是纯灰",
        "无障碍不意味着丑",
        "避免仅靠颜色传达信息"
      ]
    },
    {
      "category": "营造层次",
      "items": [
        "模拟统一的光源",
        "用阴影表达层级与海拔",
        "阴影可由两部分构成",
        "扁平风同样可具有层次",
        "通过重叠营造层次"
      ]
    },
    {
      "category": "图像处理",
      "items": [
        "使用高质量图片",
        "文本需保持一致的对比度",
        "每个元素都有预设尺寸",
        "谨慎处理用户上传内容"
      ]
    },
    {
      "category": "收尾打磨",
      "items": [
        "强化默认样式",
        "通过强调边框引入色彩",
        "适度美化背景",
        "不要忽视空状态",
        "减少使用边框",
        "跳出框架思考"
      ]
    }
  ]
}